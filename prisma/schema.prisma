// FOMSCU Student Guide Database Schema
// Developed by: Mohamed Magdy - 5th Year Medical Student at FOMSCU
// Version: 2023-2024

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Admin model for authentication
model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admins")
}

// Guide content model for dynamic CMS
model GuideContent {
  id             String   @id @default(cuid())
  sectionKey     String   @unique
  sectionTitle   String
  sectionContent String   @db.Text
  orderIndex     Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("guide_content")
}

// Student complaint system
model StudentComplaint {
  id          String   @id @default(cuid())
  studentName String
  studentId   String
  issueType   String
  message     String   @db.Text
  status      ComplaintStatus @default(PENDING)
  adminReply  String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("student_complaints")
}

enum ComplaintStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  REJECTED
}

// Elective courses catalog
model ElectiveCourse {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  year        Int
  semester    Int
  department  String?
  credits     Int      @default(2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("elective_courses")
}

// Timeline milestones
model TimelineMilestone {
  id          String   @id @default(cuid())
  year        Int
  title       String
  description String   @db.Text
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("timeline_milestones")
}

// Program phases/curriculum structure
model ProgramPhase {
  id          String   @id @default(cuid())
  phaseNumber Int
  title       String
  description String   @db.Text
  duration    String
  orderIndex  Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("program_phases")
}
