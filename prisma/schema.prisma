// FOMNINU Student Guide Database Schema - Updated with Course Details
// Developer: Mohamed Magdy - 5th Year Medical Student at FOMNINU
// New Ismailia National University - Version: 2026-2031

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Admin model for authentication
model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admins")
}

// Guide content model for dynamic CMS
model GuideContent {
  id             String   @id @default(cuid())
  sectionKey     String   @unique
  sectionTitle   String
  sectionContent String   @db.Text
  orderIndex     Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("guide_content")
}

// Student complaint system
model StudentComplaint {
  id          String   @id @default(cuid())
  studentName String
  studentId   String
  issueType   String
  message     String   @db.Text
  status      ComplaintStatus @default(PENDING)
  adminReply  String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("student_complaints")
}

enum ComplaintStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  REJECTED
}

// Elective courses catalog
model ElectiveCourse {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  year        Int
  semester    Int
  department  String?
  credits     Int      @default(2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("elective_courses")
}

// Timeline milestones
model TimelineMilestone {
  id          String   @id @default(cuid())
  year        Int
  title       String
  description String   @db.Text
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("timeline_milestones")
}

// Program phases/curriculum structure
model ProgramPhase {
  id          String   @id @default(cuid())
  phaseNumber Int
  title       String
  description String   @db.Text
  duration    String
  orderIndex  Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("program_phases")
}

// Module model - stores detailed module information
model Module {
  id              String   @id @default(cuid())
  name            String
  nameAr          String
  type            ModuleType
  year            Int
  semester        Int
  duration        String   // e.g., "7 أسابيع"
  subjects        String[] // Array of subjects
  description     String   @db.Text
  orderIndex      Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("modules")
}

enum ModuleType {
  FOUNDATION
  SYSTEMIC
  CLINICAL
}

// Exam model - stores exam types and grading
model ExamType {
  id            String   @id @default(cuid())
  name          String
  code          String   // e.g., "MCQ", "OSPE", "MEQ"
  percentage    Int      // e.g., 40 for OSPE
  description   String   @db.Text
  hasCompassion Boolean  @default(true) // Whether compassion marks apply
  orderIndex    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("exam_types")
}

// Group model - stores group A and B info
model StudentGroup {
  id          String   @id @default(cuid())
  name        String   // "Group A" or "Group B"
  description String   @db.Text
  startDay    String   // "Tuesday" or "Wednesday"
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("student_groups")
}

// Weekly Schedule model
model WeeklySchedule {
  id          String   @id @default(cuid())
  day         String
  groupType   String   // "A" or "B"
  activities  ScheduleActivity[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("weekly_schedules")
}

type ScheduleActivity {
  name: String
  time: String
  type: String // "lecture", "practical", "seminar", "skill_lab"
  attendance: Boolean // Whether attendance is required
}

// Attendance rules
model AttendanceRule {
  id          String   @id @default(cuid())
  activityType String  // "practical", "class", "seminar", "skill_lab"
  maxAbsence  Int      // Maximum allowed absence percentage
  penalty     String   @db.Text // What happens when exceeded
  description String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("attendance_rules")
}

// Study Resources
model StudyResource {
  id          String   @id @default(cuid())
  name        String
  type        ResourceType
  url         String?
  description String   @db.Text
  isRecommended Boolean @default(false)
  year        Int?     // Which year it's useful for
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("study_resources")
}

enum ResourceType {
  PDF
  VIDEO
  CHANNEL
  BOOK
  AI_TOOL
  TELEGRAM
}
